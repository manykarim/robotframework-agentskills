# Claude Code OAuth token (preferred — subscription-based billing).
# Obtain via: `claude auth login` then inspect the saved token, or generate
# via the Claude Code web console. Tokens look like `sk-ant-oat01-...`.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Fallback: Anthropic API key (per-token billing). Used if CLAUDE_CODE_OAUTH_TOKEN
# is unset. Only uncomment and set if you specifically want API-key auth.
# ANTHROPIC_API_KEY=sk-ant-...

# Default model for evaluation runs. Must be one of:
#   - claude-haiku-4-5-20251001  (cheap, fast; default for PR/narrow tasks, trigger evals)
#   - claude-sonnet-5            (higher fidelity; for realistic/adversarial tiers)
# claude-opus-5-5 is a manual, explicit opt-in only
# (--model claude-opus-5-5 --allow-opus --max-cost-usd <cap>) — see ADR-004.
CLAUDE_MODEL_DEFAULT=claude-haiku-4-5-20251001

# Log level for the harness (DEBUG, INFO, WARNING, ERROR).
RF_SKILL_EVAL_LOG_LEVEL=INFO

# Opt-out of automatic .env loading on import (set to "0" to disable).
RF_SKILL_EVAL_AUTOLOAD_DOTENV=1
